---
import { ANALYTICS } from 'astrowind:config';

const id = ANALYTICS?.vendors?.googleAnalytics?.id ? String(ANALYTICS.vendors.googleAnalytics.id) : undefined;
---

{id ? <script async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script> : null}
{
  id ? (
    <script is:inline define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args) {
        dataLayer.push(args);
      }
      gtag('js', new Date());
      gtag('config', id);
    </script>
  ) : null
}

---
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'College Coursework Tutoring',
  description:
    'College-level tutoring for high school students taking dual enrollment or college courses. Get expert help from Ivy League students in various subjects.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="College Coursework"
    image={{
      src: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'People sitting on chairs in front of a table holding pens',
    }}
    actions={[
      {
        text: 'Subjects We Support',
        href: '#courses',
      },
    ]}
  >
    <Fragment slot="title"> Excel in College Classes </Fragment>

    <Fragment slot="subtitle">
      Taking college courses while in high school can be a great way to challenge yourself and get a head start on
      higher education. We help students manage faster pacing, more independent assignments, and more rigorous exams.
    </Fragment>
  </Hero>

  <Features2
    id="courses"
    title="College Coursework"
    subtitle="Our tutors support students in dual-enrollment and introductory college coursework. Contact us if you do not see a subject listed."
    columns={3}
    tagline="Subjects We Support"
    items={[
      {
        title: 'Calculus and Mathematics',
        description:
          'Support for college algebra, precalculus, calculus, statistics, and related problem-solving courses.',
        icon: 'tabler:math-symbols',
      },
      {
        title: 'Physics and Engineering',
        description:
          'Help with mechanics, electricity and magnetism, introductory engineering, and technical study habits.',
        icon: 'tabler:atom',
      },
      {
        title: 'Chemistry and Biology',
        description:
          'Guidance for lab-heavy science courses, exam preparation, and concept review across introductory sequences.',
        icon: 'tabler:flask',
      },
      {
        title: 'Computer Science',
        description:
          'Tutoring for introductory programming, data structures, debugging, and project planning.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Writing and Humanities',
        description:
          'Help with reading-heavy courses, research papers, essay structure, citations, and revision.',
        icon: 'tabler:writing',
      },
      {
        title: 'Study Planning',
        description:
          'Practical systems for keeping up with syllabi, deadlines, office hours, and cumulative exams.',
        icon: 'tabler:calendar-check',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
</Layout>

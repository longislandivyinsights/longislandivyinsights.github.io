---
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us',
  description:
    'Meet the Long Island Ivy Insights team: advisors from Yale, Harvard, Cornell, Columbia, and MIT who provide personalized college consulting and tutoring on Long Island.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Us"
    image={{
      src: '~/assets/images/the-team.jpg',
      alt: 'The Long Island Ivy Insights and Consulting Team',
    }}
    actions={[
      {
        text: 'Our Team',
        href: '#brandon',
      },
    ]}
  >
    <Fragment slot="title"> Meet the Team </Fragment>

    <Fragment slot="subtitle">
      We are a team of students who have been through the college application process and have earned admission to the
      top universities in the United States. We are here to help students build stronger applications, clearer academic
      plans, and more confident paths toward college.
    </Fragment>
  </Hero>

  <!-- Brandon Content ******************* -->
  <Content
    id="brandon"
    columns={4}
    items={[
      {
        icon: 'tabler:school',
        callToAction: {
          text: 'Yale University',
        },
      },
      {
        icon: 'tabler:bookmark',
        callToAction: {
          text: 'Mechanical Engineering',
        },
      },
      {
        icon: 'tabler:briefcase',
        callToAction: {
          text: 'LeoLabs',
        },
      },
      {
        icon: 'tabler:tools',
        callToAction: {
          text: 'Formula SAE',
        },
      },
    ]}
    image={{
      src: '~/assets/images/brandon.jpg',
      alt: 'Brandon',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Brandon</h2>
      <p>Brandon graduated from Yale University in 2026 with a Bachelor of Science in Mechanical Engineering.</p>
      <br />
      <p>
        At Yale, he was the Chief Mechanical Engineer of the school's Formula SAE team and conducted robotics research
        at the Faboratory. Brandon is currently working at LeoLabs as a Mechanical Engineer, supporting space technology
        systems used to track satellites and orbital debris in low Earth orbit.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Christopher Content ******************* -->
  <Content
    id="christopher"
    isReversed
    columns={4}
    items={[
      {
        icon: 'tabler:school',
        callToAction: {
          text: 'MIT',
        },
      },
      {
        icon: 'tabler:school',
        callToAction: {
          text: 'Harvard University',
        },
      },
      {
        icon: 'tabler:bookmark',
        callToAction: {
          text: 'Physics',
        },
      },
      {
        icon: 'tabler:satellite',
        callToAction: {
          text: 'HUCSat',
        },
      },
    ]}
    image={{
      src: '~/assets/images/christopher.jpg',
      alt: 'Christopher',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Christopher</h2>
      <p>
        Christopher is a first-year doctoral student at the Massachusetts Institute of Technology, where he is pursuing
        a Doctor of Philosophy in Physics. He previously graduated from Harvard University with a Bachelor of Arts in
        Physics and Mechanical Engineering and a Master of Arts in Physics.
      </p>
      <br />
      <p>
        At Harvard, Christopher was the Chief Engineer of the Harvard Satellite Team, where he led development of the
        Harvard Undergraduate CubeSat, HUCSat, which launched into space in April 2026. At MIT, his research primarily
        focuses on experimental particle physics.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Gavin Content ******************* -->
  <Content
    id="gavin"
    columns={4}
    items={[
      {
        icon: 'tabler:school',
        callToAction: {
          text: 'Cornell University',
        },
      },
      {
        icon: 'tabler:bookmark',
        callToAction: {
          text: 'Computer Science',
        },
      },
      {
        icon: 'tabler:bookmarks',
        callToAction: {
          text: 'Robotics',
        },
      },
      {
        icon: 'tabler:briefcase',
        callToAction: {
          text: 'Budbreak Innovations',
        },
      },
    ]}
    image={{
      src: '~/assets/images/gavin.jpg',
      alt: 'Gavin',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Gavin</h2>
      <p>
        Gavin is a senior at Cornell University, where he is pursuing a Bachelor of Science in Computer Science.
        He is also pursuing a minor in Robotics.
      </p>
      <br />
      <p>
        Gavin is currently interning at Budbreak Innovations as a Full Stack Robotics Engineering Intern. Budbreak is
        an agtech company building AI-powered crop scouting robots for vineyards and specialty crop fields, and Gavin
        develops the perception and data pipeline behind the company's field robots.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Handsome Content ******************* -->
  <Content
    id="handsome"
    isReversed
    columns={4}
    items={[
      {
        icon: 'tabler:school',
        callToAction: {
          text: 'Columbia University',
        },
      },
      {
        icon: 'tabler:bookmark',
        callToAction: {
          text: 'Mechanical Engineering',
        },
      },
      {
        icon: 'tabler:bookmarks',
        callToAction: {
          text: 'Computer Science',
        },
      },
      {
        icon: 'tabler:briefcase',
        callToAction: {
          text: 'Joby Aviation',
        },
      },
    ]}
    image={{
      src: '~/assets/images/handsome.jpg',
      alt: 'Handsome',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Handsome</h2>
      <p>
        Handsome is a senior at Columbia University, where he is pursuing a Bachelor of Science in Mechanical
        Engineering. He is also pursuing a minor in Computer Science.
      </p>
      <br />
      <p>
        Handsome is currently interning at Joby Aviation as a Technical Project Manager for Flight Test Instrumentation.
        Joby Aviation designs and manufactures all-electric vertical takeoff and landing aircraft for fast, quiet, and
        sustainable air transportation.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- James Content ******************* -->
  <Content
    id="james"
    columns={4}
    items={[
      {
        icon: 'tabler:school',
        callToAction: {
          text: 'Cornell University',
        },
      },
      {
        icon: 'tabler:bookmark',
        callToAction: {
          text: 'Mechanical Engineering',
        },
      },
      {
        icon: 'tabler:briefcase',
        callToAction: {
          text: 'Anduril Industries',
        },
      },
      {
        icon: 'tabler:tools',
        callToAction: {
          text: 'Combat Robotics',
        },
      },
    ]}
    image={{
      src: '~/assets/images/james.jpg',
      alt: 'James',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">James</h2>
      <p>
        James graduated from Cornell University in 2026 with a Bachelor of Science in Mechanical Engineering. In the
        coming fall semester, he will complete his master's degree in Mechanical Engineering at Cornell.
      </p>
      <br />
      <p>
        During his senior year, James ran the Combat Robotics at Cornell project team as one of the Full Team Co-Leads.
        James is currently interning at Anduril Industries, a rapidly growing American defense technology company.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
</Layout>

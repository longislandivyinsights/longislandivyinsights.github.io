---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Long Island Ivy Insights and Consulting, LLC — College Consulting & Tutoring',
  ignoreTitleTemplate: true,
  description:
    'Long Island Ivy Insights and Consulting provides expert college consulting and tutoring from Ivy League students. Personalized guidance for Long Island students in college applications, essay review, SAT/ACT prep, and academic tutoring.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
        text: 'Book a Consultation',
        href: '/contact',
        variant: 'primary',
      },
      {
        text: 'Explore Services',
        href: '#college-consulting',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">College Consulting</span> + <span
        class="text-accent dark:text-white highlight">Course Tutoring</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Long Island Ivy Insights and Consulting</span> provides affordable, personalized college
      consulting and tutoring from students at Yale, Harvard, Cornell, and Columbia. We help Long Island students excel in
      their classes, build stronger applications, and move through the admissions process with a clear plan.
    </Fragment>
  </Hero>

  <!-- Why Choose Us ****************** -->
  <Features2
    title="Why Choose Us?"
    subtitle="Our team brings firsthand experience from the Ivy League admissions process to help you succeed."
    columns={3}
    items={[
      {
        title: 'Ivy League Advisors',
        description:
          'Every advisor on our team was admitted to and attends a top university, so students learn from people who recently navigated the same process.',
        icon: 'tabler:school',
      },
      {
        title: 'Personalized Support',
        description:
          'Each student receives a tailored plan for classes, testing, activities, essays, and applications instead of generic advice.',
        icon: 'tabler:users',
      },
      {
        title: 'Affordable Pricing',
        description:
          'We keep guidance practical and accessible for Long Island families, with focused services and yearly packages.',
        icon: 'tabler:wallet',
      },
    ]}
  />

  <!-- Steps Widget: College Consulting ****************** -->
  <Steps
    id="college-consulting"
    title="College applications from strategy to submission."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Planning</span>',
        description:
          "We'll help you identify goals, strengths, target schools, likely majors, and the academic or extracurricular choices that can strengthen your profile.",
        icon: 'tabler:school',
      },
      {
        title: 'Step 2: <span class="font-medium">Writing</span>',
        description:
          "We'll guide brainstorming, outlines, and drafts so essays communicate a clear story in the student's own voice.",
        icon: 'tabler:writing',
      },
      {
        title: 'Step 3: <span class="font-medium">Editing</span>',
        description:
          "We'll review essays, activity descriptions, resumes, and application details so each submission is polished and consistent.",
        icon: 'tabler:edit',
      },
      {
        title: 'Submit Your Applications!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1537888692311-8a7fb3e9f374?q=80&w=1935&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'MIT Great Dome representing top college aspirations',
    }}
  />

  <!-- Steps Widget: Tutoring ****************** -->
  <Steps
    isReversed
    id="course-tutoring"
    title="Tutoring that supports real coursework."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Assessment</span>',
        description:
          "We'll assess current class material, identify gaps, and set a realistic study plan around the student's course and test calendar.",
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'Step 2: <span class="font-medium">Teaching</span>',
        description:
          "We'll teach concepts, walk through examples, and practice the problem types or writing skills the student is seeing in class.",
        icon: 'tabler:book',
      },
      {
        title: 'Step 3: <span class="font-medium">Review</span>',
        description:
          "We'll review homework, quizzes, essays, labs, and exam prep so the student can keep improving after each session.",
        icon: 'tabler:checklist',
      },
      {
        title: 'Ace Your Classes!',
        icon: 'tabler:letter-a',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'Student receiving personalized tutoring guidance',
    }}
  />

  <!-- Call to Action ****************** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started Today',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Ready to Take the Next Step?</Fragment>

    <Fragment slot="subtitle">
      Contact us today to learn how our team of Ivy League advisors can help you achieve your academic and college
      admissions goals.
    </Fragment>
  </CallToAction>
</Layout>

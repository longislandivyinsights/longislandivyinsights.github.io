---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Long Island Ivy Insights and Consulting, LLC — College Consulting & Tutoring',
  ignoreTitleTemplate: true,
  description:
    'Long Island Ivy Insights and Consulting provides expert college consulting and tutoring from Ivy League students. Personalized guidance for Long Island students in college applications, essay review, SAT/ACT prep, and academic tutoring.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    actions={[
      {
        text: 'College Consulting',
        href: '#college-consulting',
      },
      {
        text: 'Course Tutoring',
        href: '#course-tutoring',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">College Consulting</span> + <span
        class="text-accent dark:text-white highlight">Course Tutoring</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Long Island Ivy Insights and Consulting</span> provides affordable, personalized college
      consulting and tutoring from students at Yale, Harvard, Cornell, and Columbia. We help Long Island students excel in
      their classes and earn admission into top schools.
    </Fragment>
  </Hero>

  <!-- Why Choose Us ****************** -->
  <Features2
    title="Why Choose Us?"
    subtitle="Our team brings firsthand experience from the Ivy League admissions process to help you succeed."
    columns={3}
    items={[
      {
        title: 'Ivy League Advisors',
        description:
          'Every advisor on our team was admitted to and attends a top university, giving you guidance rooted in real experience.',
        icon: 'tabler:school',
      },
      {
        title: 'Personalized Support',
        description:
          'Each student is matched with multiple advisors for a comprehensive, tailored approach to their academic journey.',
        icon: 'tabler:users',
      },
      {
        title: 'Affordable Pricing',
        description:
          'We believe expert guidance should be accessible. Our services are priced to be affordable for Long Island families.',
        icon: 'tabler:wallet',
      },
    ]}
  />

  <!-- Steps Widget: College Consulting ****************** -->
  <Steps
    id="college-consulting"
    title="College applications from start to finish."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Planning</span>',
        description:
          "We'll help you identify your goals, strengths, and weaknesses. We'll also help you choose which colleges to apply to and what you can do to stand out.",
        icon: 'tabler:school',
      },
      {
        title: 'Step 2: <span class="font-medium">Writing</span>',
        description:
          "We'll guide you through the process of writing your college essays and personal statements. We'll help you brainstorm ideas, structure your essays, and write compelling statements.",
        icon: 'tabler:writing',
      },
      {
        title: 'Step 3: <span class="font-medium">Editing</span>',
        description:
          "We'll review your essays and provide feedback on how you can improve them. We'll help you refine your ideas, strengthen your arguments, and polish your writing.",
        icon: 'tabler:edit',
      },
      {
        title: 'Submit Your Applications!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1537888692311-8a7fb3e9f374?q=80&w=1935&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'MIT Great Dome representing top college aspirations',
    }}
  />

  <!-- Steps Widget: Tutoring ****************** -->
  <Steps
    isReversed
    id="course-tutoring"
    title="Tutoring for all high school courses."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Assessment</span>',
        description:
          "We'll assess your current understanding of the subject and identify areas where you need help. We'll also help you set goals and create a study plan.",
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'Step 2: <span class="font-medium">Teaching</span>',
        description:
          "We'll teach you the material you need to know and help you practice solving problems. We'll explain concepts, provide examples, and answer your questions.",
        icon: 'tabler:book',
      },
      {
        title: 'Step 3: <span class="font-medium">Review</span>',
        description:
          "We'll review the material you've learned and help you prepare for tests and exams. We'll quiz you on key concepts, test your understanding, and provide feedback on your performance.",
        icon: 'tabler:checklist',
      },
      {
        title: 'Ace Your Classes!',
        icon: 'tabler:letter-a',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'Student receiving personalized tutoring guidance',
    }}
  />

  <!-- Call to Action ****************** -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started Today',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Ready to Take the Next Step?</Fragment>

    <Fragment slot="subtitle">
      Contact us today to learn how our team of Ivy League advisors can help you achieve your academic and college
      admissions goals.
    </Fragment>
  </CallToAction>
</Layout>

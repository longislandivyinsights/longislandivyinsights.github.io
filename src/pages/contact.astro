---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact Us',
  description:
    'Get in touch with Long Island Ivy Insights and Consulting. Contact us for college consulting, tutoring, and application support on Long Island, NY.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact Us" title="Let's Connect" />

  <ContactUs
    id="form"
    title="Tell us what you need"
    subtitle="Share the student's grade, goals, and the services you are interested in. We will follow up with next steps."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="We are here to help"
    items={[
      {
        title: 'Email',
        description: '<a href="mailto:longislandivyinsights@gmail.com">longislandivyinsights@gmail.com</a>',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: 'Long Island, NY',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
